# SmartStore NG — environment variables
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# Do NOT commit your real `.env` file. VITE_* vars are exposed to the
# browser bundle, so only ever use PUBLIC keys here.

# ---- Supabase (live backend) ------------------------------------------------
# Leave both blank to run the app entirely in local demo mode (localStorage).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Paystack (billing) -----------------------------------------------------
# Public key only — use a test key to experiment, swap for the live key before
# going to production. When blank/absent the Pricing page falls back to a free
# "demo upgrade" that unlocks Owner Mode locally.
#
#   Test:  pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   Live:  pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
